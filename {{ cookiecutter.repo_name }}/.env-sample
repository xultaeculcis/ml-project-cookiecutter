# Copy this file to `.env` and change the values. `.env` is git-ignored: never commit secrets.
# Settings are loaded by `{{ cookiecutter.package_name }}.core.settings` (pydantic-settings).
# Real environment variables override values from `.env`.

ENVIRONMENT=local

# MLflow settings section (`settings.mlflow`). A real `MLFLOW_TRACKING_URI` / `MLFLOW_EXPERIMENT_NAME` environment
# variable (set by Azure ML and other managed platforms) takes priority over these values.
# `make mlflow-ui` uses `MLFLOW_TRACKING_URI` from the shell, default `sqlite:///mlflow.db`.
MLFLOW__TRACKING_URI=sqlite:///mlflow.db
# MLFLOW__EXPERIMENT_NAME=

# Optional storage section (`settings.storage`). Code that needs it calls `settings.storage.require(...)`.
# STORAGE__URL=
# STORAGE__ACCESS_KEY=

# Nested settings sections use "__" as the delimiter (env_nested_delimiter="__").
# Example: a `section` field with a `key` sub-field is set with:
# SECTION__KEY=value

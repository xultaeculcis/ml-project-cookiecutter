# Python bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Build and packaging
build/
dist/
wheels/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment files (commit only .env-sample)
.env
.env.*
*.env
!.env-sample

# Test, coverage and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
test-results/
junit*.xml

# Jupyter
.ipynb_checkpoints/

# Documentation build output
/site/
/docs-site/

# IDEs and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Data: keep the folder layout (.gitkeep), ignore the content
/data/*/*
!/data/*/.gitkeep

# Notebooks: keep only notebooks
/notebooks/*
!/notebooks/*.ipynb
!/notebooks/.gitkeep

# Experiment tracking, training outputs and model weights
mlflow.db
mlruns/
mlartifacts/
lightning_logs/
/logs/
/outputs/
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
*.zip
